{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "buildCommand": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/",
      "destination": "/app.html"
    },
    {
      "source": "/overlay",
      "destination": "/app.html?overlay=1"
    },
    {
      "source": "/overlay/",
      "destination": "/app.html?overlay=1"
    },
    {
      "source": "/demo",
      "destination": "/app.html?demo"
    },
    {
      "source": "/demo/",
      "destination": "/app.html?demo"
    },
    {
      "source": "/orchestra",
      "destination": "/app.html?mode=orchestra"
    },
    {
      "source": "/orchestra/",
      "destination": "/app.html?mode=orchestra"
    },
    {
      "source": "/replay",
      "destination": "/app.html?mode=replay"
    },
    {
      "source": "/replay/",
      "destination": "/app.html?mode=replay"
    },
    {
      "source": "/band",
      "destination": "/app.html?mode=band"
    },
    {
      "source": "/band/",
      "destination": "/app.html?mode=band"
    },
    {
      "source": "/console",
      "destination": "/app.html?console=1"
    },
    {
      "source": "/console/",
      "destination": "/app.html?console=1"
    },
    {
      "source": "/diagnostics",
      "destination": "/app.html?diag=1"
    },
    {
      "source": "/diagnostics/",
      "destination": "/app.html?diag=1"
    },
    {
      "source": "/besthour",
      "destination": "/app.html?besthour=1"
    },
    {
      "source": "/besthour/",
      "destination": "/app.html?besthour=1"
    },
    {
      "source": "/share",
      "destination": "/app.html?share=1"
    },
    {
      "source": "/share/",
      "destination": "/app.html?share=1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=(self)"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(app|overlay|demo|orchestra|replay|band|console|diagnostics|besthour|share)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff2"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/card.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
