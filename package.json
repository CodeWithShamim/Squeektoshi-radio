{
  "name": "squeektoshi-radio",
  "version": "1.0.0",
  "description": "Hamster-powered generative music station running entirely in the browser on Squeekchain PoW telemetry",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/mapping.test.js tests/replay.test.js tests/api.test.js",
    "test:e2e": "npx playwright test",
    "test:a11y": "node tests/audit-a11y.js",
    "start": "node server.js",
    "card": "node tools/make-card.js"
  },
  "keywords": [
    "squeekchain",
    "web-audio",
    "generative-music",
    "proof-of-work",
    "hamster"
  ],
  "author": "Squeektoshi Radio Team",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "gsap": "^3.12.5",
    "three": "^0.162.0"
  }
}
